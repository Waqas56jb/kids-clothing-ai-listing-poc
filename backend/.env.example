OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

MATCH_MERGE_THRESHOLD=0.85
MATCH_REVIEW_THRESHOLD=0.65
GENDER_CONFIDENCE_THRESHOLD=0.75
CONDITION_CONFIDENCE_THRESHOLD=0.92

MODELS_CACHE_DIR=models_cache
DETECTOR_MODEL_ID=IDEA-Research/grounding-dino-tiny
SAM_CHECKPOINT=sam2_t.pt
CLIP_MODEL_NAME=ViT-B-32-quickgelu
CLIP_PRETRAINED=openai

# AWS Postgres (records) + S3 (files). No Supabase.
DATABASE_URL=postgresql://kidsai:CHANGE_ME@127.0.0.1:5432/kidsai
DATABASE_SSL=disable
JWT_SECRET=change-me-long-random-string
S3_BUCKET=kids-ai-listing-files
S3_PREFIX=job-files
AWS_DEFAULT_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
