OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

MATCH_MERGE_THRESHOLD=0.85
MATCH_REVIEW_THRESHOLD=0.65
GENDER_CONFIDENCE_THRESHOLD=0.75
CONDITION_CONFIDENCE_THRESHOLD=0.92

MODELS_CACHE_DIR=models_cache
DETECTOR_MODEL_ID=IDEA-Research/grounding-dino-tiny
SAM_CHECKPOINT=sam2_t.pt
CLIP_MODEL_NAME=ViT-B-32-quickgelu
CLIP_PRETRAINED=openai

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Required on Railway and locally so jobs are stored in Postgres (not process memory).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

